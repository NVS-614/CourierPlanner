# Google Cloud OAuth 2.0 Web application credentials.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Add this exact URL to the OAuth client's authorized redirect URIs.
GOOGLE_CALLBACK_URL=https://courierplanner.runasp.net/auth/google/callback
# Local development alternative:
# GOOGLE_CALLBACK_URL=http://localhost:5001/auth/google/callback

# Comma-separated Gmail addresses permitted to open Swagger.
SWAGGER_ALLOWED_EMAILS=developer@gmail.com

# Generate a random value with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SWAGGER_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
